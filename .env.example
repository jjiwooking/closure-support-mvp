# 이 파일을 복사해 .env로 저장하고 실제 값을 채운다. .env는 git에 커밋하지 않는다.

# Postgres 연결 문자열. docker-compose.yml의 자격증명과 일치하는 기본값이 db.py에
# 이미 들어있으므로, `docker compose up -d`로 로컬 컨테이너를 쓸 경우 비워둬도 된다.
# 다른 Postgres(클라우드 등)를 쓰려면 이 값을 채운다.
# DATABASE_URL=postgresql://closure:closure@localhost:5432/closure_support

# "production"으로 설정하면 세션 쿠키에 Secure 속성이 붙어 HTTPS로만 전송된다.
# 로컬 개발(평문 HTTP)에서는 절대 production으로 두지 말 것 — 로그인이 안 됨.
# ENVIRONMENT=development

# api.py가 허용할 프론트엔드 origin(콤마 구분). 배포 시 실제 프론트 도메인으로 교체.
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 기업마당 지원사업정보 API 서비스키
# 발급: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi -> 로그인 -> 사용신청
BIZINFO_API_KEY=

# 공공데이터포털(data.go.kr, odcloud) "대한민국 공공서비스 정보" API 일반 인증키
DATA_GO_KR_API_KEY=

# 제품안전정보센터(safetykorea.kr) 인증정보 조회 API 서비스키
# 주의: 이 API는 "사진으로 제품 인식"이 아니라 모델명/인증번호로 안전인증 정보를
# 조회하는 DB다. 사진 인식 자체는 Gemini 멀티모달(LLM_API_KEY)로 처리하고,
# 여기서는 그 결과를 국내 인증정보로 한 번 더 검증하는 보조 용도로만 쓴다.
SAFETYKOREA_API_KEY=

# LLM 공급자 (예: anthropic, gemini, openai) - 조원과 상의해 확정
LLM_PROVIDER=
LLM_API_KEY=
# 생성 모델(비워두면 코드 기본값 사용). 지연시간/비용이 중요하면 Flash-Lite 계열도
# 고려해볼 것 — 정확한 모델 식별자는 시점에 따라 바뀌므로 Google AI Studio 콘솔에서
# 확인 후 아래 주석을 풀고 채운다.
# LLM_MODEL=

# api.py(FastAPI) 세션 쿠키 서명키. 비워두면 프로세스 시작마다 무작위 생성되어
# 재시작할 때마다 기존 로그인 세션이 끊긴다. 여러 인스턴스로 띄우거나 재시작
# 후에도 세션을 유지하려면 값을 채운다(예: python -c "import secrets; print(secrets.token_hex(32))").
# API_SESSION_SECRET=
